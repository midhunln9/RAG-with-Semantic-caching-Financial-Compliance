FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    STREAMLIT_SERVER_HEADLESS=true \
    BACKEND_CHAT_URL=http://backend:8000/chat

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --only-group frontend --no-install-project

COPY streamlit_chat_ui ./streamlit_chat_ui

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_chat_ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
